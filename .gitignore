# OS
.DS_Store

# Diagram sources (kept local, exported PNGs are committed)
*.excalidraw

# Personal / source documents — never publish to the public repo.
# Anchored with a leading slash so it matches only the folder at the repo
# root. Unanchored, git matches a directory of this name at any depth, and
# on a case-insensitive filesystem that silently swallows src/content/ —
# the entire content layer of the site.
/Content/
*.docx
*.doc
*.pdf
GitHub_Portfolio_Roadmap.md
portfolio-strategy.md
PortfolioHero.mp4

# Build output & deps
node_modules/
dist/
.astro/
.netlify/
.vercel/

# Env
.env
.env.production
.env*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# HyperFrames render artifacts (the composition itself is committed)
src/hero/snapshots/
src/hero/out/
src/hero/.hyperframes/
