---
interface Props {
  title: string;
  blurb: string;
  tags: string[];
  link?: string;
}

const { title, blurb, tags, link } = Astro.props;
const Tag = link ? 'a' : 'div';
---

<Tag
  {...link ? { href: link, target: '_blank', rel: 'noopener noreferrer' } : {}}
  class:list={[
    'card p-5 block',
    link ? 'hover:-translate-y-0.5' : 'hover:shadow-none hover:border-border',
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-semibold text-charcoal">{title}</h3>
    {
      link && (
        <svg
          class="w-4 h-4 text-muted shrink-0 mt-0.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M9 7h8v8" />
        </svg>
      )
    }
  </div>
  <p class="mt-2 text-sm text-muted leading-relaxed">{blurb}</p>
  <div class="mt-4 flex flex-wrap gap-1.5">
    {tags.map((tag) => <span class="tech-tag">{tag}</span>)}
  </div>
</Tag>
