---
// Job-radar sibling of StatusPill. Kept separate on purpose: StatusPill's
// enum is load-bearing for case-study provenance and should not widen.
interface Props {
  status: 'new' | 'reviewing' | 'applied' | 'passed' | 'closed';
  class?: string;
}

const { status, class: className = '' } = Astro.props;

const dotClass = {
  new: 'bg-accent status-dot-live',
  reviewing: 'bg-cyan',
  applied: 'bg-success',
  passed: 'bg-muted',
  closed: 'bg-muted',
}[status];
---

<span
  class:list={[
    'inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.08em] text-muted',
    className,
  ]}
>
  <span class:list={['w-1.5 h-1.5 rounded-full shrink-0', dotClass]} aria-hidden="true"></span>
  {status}
</span>
