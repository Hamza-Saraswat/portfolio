---
import JobStatusPill from './JobStatusPill.astro';

interface Props {
  company: string;
  title: string;
  url: string;
  location: string;
  stage?: string;
  fitNotes: string;
  trackLabel: string;
  tags: string[];
  status: 'new' | 'reviewing' | 'applied' | 'passed' | 'closed';
}

const { company, title, url, location, stage, fitNotes, trackLabel, tags, status } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="card p-5 block hover:-translate-y-0.5"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-semibold text-charcoal">{company}</h3>
    <svg
      class="w-4 h-4 text-muted shrink-0 mt-0.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M9 7h8v8" />
    </svg>
  </div>
  <p class="mt-1 text-sm font-medium text-ink">{title}</p>
  <p class="mt-1.5 font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
    {location}{stage && ` · ${stage}`}
  </p>
  <p class="mt-3 text-sm text-muted leading-relaxed">{fitNotes}</p>
  <div class="mt-4 flex items-end justify-between gap-3">
    <div class="flex flex-wrap gap-1.5">
      <span class="tech-tag">{trackLabel}</span>
      {tags.map((tag) => <span class="tech-tag">{tag}</span>)}
    </div>
    <JobStatusPill status={status} class="shrink-0" />
  </div>
</a>
