---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="my-10 breakout">
  <div class="card overflow-hidden bg-surface p-4 md:p-6">
    <Image
      src={src}
      alt={alt}
      widths={[640, 960, 1400, 2000]}
      sizes="(min-width: 1024px) 1000px, 92vw"
      class="w-full h-auto"
      loading="lazy"
    />
  </div>
  {caption && <figcaption class="mt-3 text-sm text-muted text-center">{caption}</figcaption>}
</figure>
