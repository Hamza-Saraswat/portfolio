---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('writing', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formatted = entry.data.pubDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={entry.data.title} description={entry.data.description} type="article">
  <article class="py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="prose-column">
        <a
          href="/writing/"
          class="inline-flex items-center gap-2 text-sm text-muted hover:text-accent transition-colors mb-8"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
          </svg>
          All writing
        </a>

        {
          formatted && (
            <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted mb-4">
              {formatted}
            </p>
          )
        }

        <h1 class="t-display">{entry.data.title}</h1>
        <p class="t-lede mt-5">{entry.data.description}</p>

        <div class="prose prose-site mt-12 max-w-none">
          <Content />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
