---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const caseStudies = (await getCollection('caseStudies', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Work"
  description="Five case studies on production AI systems: agents on live inboxes, guardrail pipelines, evaluation harnesses, and the systems integration behind them."
>
  <section class="pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="max-w-[1200px] mx-auto px-6">
      <p class="t-eyebrow">Work</p>
      <h1 class="t-display mt-4">The work</h1>
      <p class="t-lede mt-6 max-w-[46rem]">
        Five systems, five different ways they could have gone wrong. Each case study says what
        it does, how it is built, and what it had to get right.
      </p>
    </div>
  </section>

  <section class="pb-20 md:pb-28">
    <div class="max-w-[1200px] mx-auto px-6">
      <h2 class="sr-only">Case studies</h2>
      <div class="grid md:grid-cols-2 gap-6" data-reveal-stagger>
        {caseStudies.map((entry) => <ProjectCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-24 bg-surface border-t border-border">
    <div class="max-w-[1200px] mx-auto px-6 text-center" data-reveal>
      <h2 class="t-h2">Got something that has to work?</h2>
      <p class="t-lede mt-5 mx-auto max-w-[38rem]">
        Tell me what you are building and where you think it breaks.
      </p>
      <div class="mt-8">
        <a href="/contact/" class="btn-primary">Get in touch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/motion.ts';
</script>
