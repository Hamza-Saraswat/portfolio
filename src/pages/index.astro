---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVideo from '../components/HeroVideo.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatsBar from '../components/StatsBar.astro';
import ScrollPinnedSection from '../components/ScrollPinnedSection.astro';

import supportInboxPipeline from '../assets/diagrams/support-inbox-pipeline.png';
import statusPagesArchitecture from '../assets/diagrams/status-pages-architecture.png';
import assistantArchitecture from '../assets/diagrams/knowledge-assistant-architecture.png';
import onboardingOrchestrator from '../assets/diagrams/onboarding-orchestrator.png';

const caseStudies = (await getCollection('caseStudies', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const capabilities = [
  {
    title: 'Evals, not vibes',
    body: 'Every system I ship has a way of telling me when it gets worse. Regression suites built from cases that actually happened, and gates I deliberately try to break — a check that has never failed has not been tested.',
    tags: ['Braintrust', 'Golden fixtures', 'LLM-as-judge'],
    image: supportInboxPipeline,
    imageAlt: 'An intake funnel feeding a confidence judge',
    proofLabel: 'Support inbox agent',
    proofHref: '/work/support-inbox-agent/',
  },
  {
    title: 'Fail closed, not open',
    body: 'When money is involved, the question is not whether the model is good — it is what happens when it is wrong. On the payments agent the model never writes the message: it picks a template and fills in the blanks.',
    tags: ['Guardrails', 'PII guards', 'Template-first'],
    image: statusPagesArchitecture,
    imageAlt: 'Three flows and a five-stage fail-closed cleaner',
    proofLabel: 'Customer status pages',
    proofHref: '/work/customer-status-pages/',
  },
  {
    title: 'People can always stop it',
    body: 'Every draft lands somewhere a person can read it, change it, or kill it before a customer does. On the support agent, auto-send stayed off for the entire first rollout — on purpose. Automation earns trust by being interruptible.',
    tags: ['Review dashboards', 'Escalation', 'Slack'],
    image: assistantArchitecture,
    imageAlt: 'Retrieval architecture with escalation and feedback paths',
    proofLabel: 'Internal knowledge assistant',
    proofHref: '/work/internal-knowledge-assistant/',
  },
  {
    title: 'The integration nobody demos',
    body: 'Salesforce, four internal services, three different auth schemes, and an API budget with no room to spare. Plus orchestration that fails softly, so a customer is never stranded halfway through setting up their account.',
    tags: ['Salesforce', 'Next.js', 'Supabase'],
    image: onboardingOrchestrator,
    imageAlt: 'The fail-soft onboarding orchestrator',
    proofLabel: 'Onboarding platform',
    proofHref: '/work/onboarding-platform/',
  },
];

const stats = [
  { value: '4', label: 'Systems in production' },
  { value: '1,000+', label: 'Questions answered' },
  { value: '180+', label: 'Automated tests' },
  { value: '4', label: 'Services integrated' },
];
---

<BaseLayout>
  {/* ===================== HERO ===================== */}
  <section class="relative overflow-hidden pt-16 pb-20 md:pt-24 md:pb-28">
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(99,91,255,0.06) 0%, transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="max-w-[1200px] mx-auto px-6 relative">
      <div class="grid md:grid-cols-2 gap-14 md:gap-12 items-center">
        <div>
          <p class="t-eyebrow hero-seq hero-seq-1">AI Engineer · Dallas, TX</p>
          <h1 class="t-display mt-4 hero-seq hero-seq-2">
            I build AI systems that <span class="gradient-text gradient-sweep"
              >hold up in production</span
            >.
          </h1>
          <p class="t-lede mt-6 hero-seq hero-seq-3">
            Four of mine run at FieldPulse right now — drafting support email, handling payment
            notices, answering questions in Slack, and keeping customers updated on their
            tickets.
          </p>
          <div class="mt-9 flex flex-wrap gap-4 hero-seq hero-seq-4">
            <a href="/work/" class="btn-primary">View my work</a>
            <a href="/contact/" class="btn-secondary">Get in touch</a>
          </div>
        </div>

        <div class="flex justify-center">
          <HeroVideo />
        </div>
      </div>
    </div>
  </section>

  {/* ===================== FEATURED WORK ===================== */}
  <section class="py-20 md:py-28 bg-surface border-t border-border">
    <div class="max-w-[1200px] mx-auto px-6">
      <SectionHeading
        eyebrow="Selected work"
        title="Five systems in production"
        lede="What each one does, how it is built, and what it had to get right before it could touch a customer."
        data-reveal
      />

      <div class="mt-12 grid md:grid-cols-2 gap-6" data-reveal-stagger>
        {caseStudies.map((entry) => <ProjectCard entry={entry} />)}
      </div>
    </div>
  </section>

  {/* ===================== CAPABILITIES ===================== */}
  <section class="py-20 md:py-28">
    <div class="max-w-[1200px] mx-auto px-6">
      <SectionHeading
        eyebrow="What I bring"
        title="Four things that keep a system alive"
        lede="Getting a model to do something impressive takes an afternoon. These decide whether it is still trusted six months later."
        data-reveal
      />
      <ScrollPinnedSection items={capabilities} />
    </div>
  </section>

  {/* ===================== STATS ===================== */}
  <StatsBar stats={stats} />

  {/* ===================== CTA ===================== */}
  <section class="py-20 md:py-28">
    <div class="max-w-[1200px] mx-auto px-6 text-center" data-reveal>
      <h2 class="t-h2">Got something that has to work?</h2>
      <p class="t-lede mt-5 mx-auto max-w-[38rem]">
        If you are putting an AI system in front of real users, that is the work I do. Tell me
        what you are building and where you think it breaks.
      </p>
      <div class="mt-9 flex flex-wrap gap-4 justify-center">
        <a href="/contact/" class="btn-primary">Get in touch</a>
        <a href="/about/" class="btn-secondary">More about me</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/motion.ts';
</script>
