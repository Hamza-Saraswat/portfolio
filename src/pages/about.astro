---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE } from '../consts';

const capabilities = [
  {
    title: 'Evaluation and measurement',
    tools: ['Braintrust', 'LLM-as-judge', 'Golden fixtures', 'Regression tests'],
  },
  {
    title: 'Agents and retrieval',
    tools: ['MCP', 'RAG', 'Tool-use loops', 'Structured output', 'OpenRouter'],
  },
  {
    title: 'Product engineering',
    tools: ['TypeScript', 'Next.js', 'React', 'Node.js', 'Supabase', 'Postgres'],
  },
  {
    title: 'Integration and delivery',
    tools: ['Salesforce', 'Slack', 'Railway', 'Vercel', 'Vitest', 'Claude Code'],
  },
];

/**
 * Headshot is optional and drop-in: save an image at
 * src/assets/headshot.(jpg|jpeg|png|webp) and it appears here, sized and
 * optimised. With no file present the page stays text-led rather than
 * rendering an empty placeholder box.
 */
const headshotFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/headshot.{jpg,jpeg,png,webp}',
  { eager: true }
);
const headshot = Object.values(headshotFiles)[0]?.default;
---

<BaseLayout
  title="About"
  description="AI engineer in Dallas–Fort Worth. I build AI systems that run in production, with the evaluation and guardrails that keep them trustworthy."
>
  <section class="pt-16 pb-14 md:pt-24 md:pb-20">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="prose-column">
        {
          headshot && (
            <Image
              src={headshot}
              alt="Hamza Saraswat"
              widths={[160, 320, 480]}
              sizes="160px"
              class="w-32 h-32 md:w-40 md:h-40 rounded-2xl object-cover border border-border shadow-[0_1px_2px_rgba(48,49,61,0.06),0_8px_24px_rgba(48,49,61,0.08)] mb-8"
              loading="eager"
            />
          )
        }
        <p class="t-eyebrow">About</p>
        <h1 class="t-display mt-4">
          I work on the part <span class="gradient-text">after the demo</span>.
        </h1>

        <div class="mt-8 space-y-5 t-body">
          <p>
            I build AI systems at FieldPulse, a field service management platform in Dallas. Four
            of them are in production: an agent drafting support email, one handling payment
            notices, an assistant answering product questions in Slack, and the pipeline behind
            our customer status pages.
          </p>
          <p>
            Getting a model to produce something impressive is a demo. Knowing what it does on
            the day retrieval comes back empty, or the provider changes a model underneath you,
            or the output is about to reach a customer who will act on it — that is the
            engineering, and it is most of the job.
          </p>
          <p>
            I came into this through marketing and automation work, building n8n workflows before
            I was building agents. The through-line is the same: work out what a process actually
            does, then make the repetitive part run itself without anyone having to trust it
            blindly.
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-2">
          <span class="tech-tag">{SITE.location}</span>
          <span class="tech-tag">AI Engineer</span>
          <span class="tech-tag">Forward Deployed</span>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-surface border-t border-border">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="prose-column">
        <SectionHeading eyebrow="Toolkit" title="What I work with" data-reveal />
        <div class="mt-10 grid sm:grid-cols-2 gap-6" data-reveal-stagger>
          {
            capabilities.map((group) => (
              <div class="card p-5">
                <h3 class="font-semibold text-charcoal">{group.title}</h3>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {group.tools.map((tool) => (
                    <span class="tech-tag">{tool}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <div class="mt-12 pt-8 border-t border-border" data-reveal>
          <h3 class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted mb-4">
            Education
          </h3>
          <p class="text-charcoal font-medium">University of Texas at Arlington</p>
          <p class="text-sm text-muted mt-1">Bachelor of Arts · May 2022</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-border">
    <div class="max-w-[1200px] mx-auto px-6 text-center" data-reveal>
      <h2 class="t-h2">Want to talk?</h2>
      <p class="t-lede mt-5 mx-auto max-w-[38rem]">
        I am open to AI engineering and forward-deployed roles, and to consulting work.
      </p>
      <div class="mt-8">
        <a href="/contact/" class="btn-primary">Get in touch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/motion.ts';
</script>
