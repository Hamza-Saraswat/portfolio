---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Message sent" description="Thanks for getting in touch." noindex={true}>
  <section class="py-28 md:py-36">
    <div class="max-w-[1200px] mx-auto px-6 text-center">
      <div
        class="w-12 h-12 rounded-xl bg-accent-light border border-accent-border flex items-center justify-center mx-auto"
      >
        <svg
          class="w-6 h-6 text-accent"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>

      <h1 class="t-h2 mt-7">Message sent</h1>
      <p class="t-lede mt-5 mx-auto max-w-[34rem]">
        Thanks for reaching out. I'll get back to you shortly.
      </p>

      <div class="mt-9 flex flex-wrap gap-4 justify-center">
        <a href="/work/" class="btn-primary">Read a case study</a>
        <a href="/" class="btn-secondary">Back home</a>
      </div>
    </div>
  </section>
</BaseLayout>
